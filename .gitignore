# @todo remove Vagrant ignores
/.vagrant
/*console.log

# output folder from Docker command (and side-by-side builds: dist-wifi, dist-nowifi...)
/dist
/dist.tar
/dist-*/
/dist-*.tar

# secrets: the aisstream.io API key the cruise map once used (no longer: kept ignored so a copy left
# in the tree isn't committed)
ais.key
# module signing keys (tools/apps/pack.py --key): never in the repository
*.pem

# Python caches (from running the tools and apps on a desktop)
__pycache__/
*.pyc
/tools/sim-out/
sim-out/

# vacation theme sources (photos, STL, skies: large, and the photos are copyrighted)
# and the theme generator's intermediate files; see apps/cruise/scenes/*/SOURCES.md
/assets/
/tools/themegen/work/

# macOS folder metadata
.DS_Store


# the fleet map builder's previews (tools/themegen/build_map.py): for looking at on a desktop, not installed
/apps/cruise/map/preview_*.png

# the ESP32 WiFi firmware build (tools/wifi/build_esp_firmware.sh)
/tools/wifi/work/
/tools/wifi/out/

# app folders laid out by tools/apps/layout.py, packed apps, and the drawing library built for a desktop
/build/
/apps/countdown/fx/libvacfx.*

# the tools' Python environment (docs/tools.md)
.venv/
# the boot splashes' previews (tools/themegen/app_splash.py)
/apps/*/splash/preview.png
