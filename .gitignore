# @todo remove Vagrant ignores
/.vagrant
/*console.log

# output folder from Docker command (and side-by-side builds: dist-wifi, dist-nowifi...)
/dist
/dist.tar
/dist-*/
/dist-*.tar

# secrets: the aisstream.io API key (it belongs on the board, /apps/data/vacation/cruise/ais.key; this
# only guards against a copy landing in the tree)
ais.key
# module signing keys (tools/modules/pack.py --key): never in the repository
*.pem

# Python caches (e.g. from running clock/fbclock.py on a desktop)
__pycache__/
*.pyc
/tools/sim-out/
sim-out/

# vacation theme sources (photos, STL, skies: large, and the photos are copyrighted)
# and the theme generator's intermediate files; see vacation/modules/cruise/scenes/*/SOURCES.md
/assets/
/tools/themegen/work/

# macOS folder metadata
.DS_Store

# the Blender-rendered Dream plates: not used by the app, regenerated by tools/themegen/build_dream.sh
/vacation/modules/cruise/scenes/dream-blender/*.png
/vacation/modules/cruise/scenes/dream-blender/scene.json

# the fleet map builder's previews (tools/themegen/build_map.py): for looking at on a desktop, not installed
/vacation/modules/cruise/map/preview_*.png

# the ESP32 WiFi firmware build (tools/wifi/build_esp_firmware.sh)
/tools/wifi/work/
/tools/wifi/out/

# app folders laid out by tools/board/deploy_app.py, and the vacation library built for a desktop
/build/
/vacation/fx/libvacfx.*
