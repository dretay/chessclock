config BR2_PACKAGE_FBVACATION
	bool "fbvacation"
	depends on BR2_PACKAGE_PYTHON3
	depends on !BR2_PACKAGE_FBCLOCK  # both are the full-screen app started at boot
	select BR2_PACKAGE_ZLIB          # the theme's images are gzipped
	select BR2_PACKAGE_LIBFFI        # Python's ctypes, which loads the drawing library
	help
	  Full-screen vacation countdown for the framebuffer: a photo of the
	  ship at sea that follows the time of day, with cabin lights, a
	  rippling sea, smoke and fireworks, and a flip-clock of the days
	  left. The drawing is a small C library (libvacfx). Source in
	  vacation/ of this repository.

comment "fbvacation needs python3, and can't be built alongside fbclock"
	depends on !BR2_PACKAGE_PYTHON3 || BR2_PACKAGE_FBCLOCK
