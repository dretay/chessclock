{
  "id": "cruise",
  "name": "Disney cruise",
  "version": "3.1.3",
  "runtime": "countdown",
  "api": 4,
  "exclude": [
    "map/preview_*.png",
    "scenes/*/SOURCES.md",
    "scenes/*/preview.png",
    "splash/preview.png"
  ],
  "scene": {
    "engine": "scene",
    "dir": "scenes",
    "default": "dream"
  },
  "screens": [
    {
      "type": "ships",
      "enabled": "MAP",
      "secs": "MAP_SECS"
    }
  ],
  "settings": [
    {
      "key": "MAP_SHIP",
      "label": "Follow",
      "note": "the ship the map centres on",
      "type": "one",
      "options": [
        "Disney Magic",
        "Disney Wonder",
        "Disney Dream",
        "Disney Fantasy",
        "Disney Wish",
        "Disney Treasure",
        "Disney Destiny",
        "Disney Adventure"
      ],
      "strip": "Disney ",
      "fallback": "SHIP",
      "default": "Disney Dream"
    }
  ],
  "countdown": {
    "date_label": "Sail date",
    "after": "Already sailed",
    "time": "16:00"
  }
}
