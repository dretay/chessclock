# WiFi through an ESP32 on SPI1 (build with --build-arg WIFI=1; see package/esp-hosted).
# Costs about 4 MB of the Nano's 32: too much alongside a countdown app without swap (S01swap), fine on an F1C200s.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_PACKET=y
CONFIG_INET=y
# CONFIG_INET_DIAG is not set
# CONFIG_IPV6 is not set
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
# CONFIG_CFG80211_DEFAULT_PS is not set
CONFIG_BT=m
CONFIG_SPI=y
CONFIG_SPI_SUN6I=y
