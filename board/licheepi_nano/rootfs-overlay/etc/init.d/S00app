#!/bin/sh
#
# Mounts the apps partition (the SD card's third, at /apps; see docs/apps.md), sets the CPU clock,
# and shows the boot splash of the app that's chosen to start, if it has one (/apps/NAME/splash.sh),
# as early as possible.
#
# The CPU clock: 600 MHz (the F1C100s's own is 408; 600 ran cleanly in testing, and the countdown's
# log reports a "self-check" each minute), or CPU_MHZ in the device's settings, /apps/data/device.conf
# (a multiple of 24; 408 for the chip's own). Set before the splash, so the rest of the boot is quicker.
# Also makes the folders the read-only base system keeps its few writable things in (/apps/data/system).
#

case "$1" in
	start)
		mount -t ext4 -o noatime /dev/mmcblk0p3 /apps 2>/dev/null
		mkdir -p /apps/data/system/seedrng
		MHZ=600
		if [ -r /apps/data/device.conf ]; then
			while IFS='=' read -r KEY VALUE; do [ "$KEY" = CPU_MHZ ] && [ -n "$VALUE" ] && MHZ=$VALUE; done < /apps/data/device.conf
		fi
		case "$MHZ" in [1-9][0-9][0-9]) setcpu "$MHZ" >/dev/null ;; esac
		A=
		[ -r /apps/current ] && read -r A < /apps/current
		if [ -n "$A" ] && [ -f "/apps/$A/splash.sh" ]; then
			# (sourced in a subshell rather than run: starting a program is slow on this CPU)
			( cd "/apps/$A" && APP_DATA=/apps/data/$A && . ./splash.sh )
		fi
		;;
	stop|restart|reload)
		;;
	*)
		echo "Usage: $0 {start}"
		exit 1
		;;
esac
