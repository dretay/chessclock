#!/bin/sh
# The active module's background job (its own `service`, e.g. the cruise's AIS feed), beside the
# countdown. /etc/init.d/S99app runs this, in this folder with APP_DATA set, and starts it again if
# it exits. See modules.py.
#
# Every module's job so far needs the network, so with no WiFi in this kernel it just sleeps: a
# fetcher that can never connect would only take memory the countdown needs. No Python stays
# resident here either way: it hands over to the module's service (exec) or to sleep.
forever() { exec sleep 2147483647; }
[ -d /sys/class/ieee80211 ] || forever
M=$(sed -n 's/^MODULE=\([A-Za-z0-9_-]*\).*/\1/p' "$APP_DATA/vacation.conf" 2>/dev/null | tail -n 1)
M=${M:-cruise}
[ -x "modules/$M/service" ] || M=cruise
[ -x "modules/$M/service" ] || forever
export MODULE_DATA="$APP_DATA/$M"
mkdir -p "$MODULE_DATA"
cd "modules/$M" && exec ./service
