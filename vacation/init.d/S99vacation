#!/bin/sh
#
# Start the vacation countdown, and restart it if it ever exits.
#

DAEMON=/usr/bin/vacation
PIDFILE=/var/run/vacation.pid          # the restart loop
APPPIDFILE=/var/run/vacation-app.pid   # the countdown itself
# kept on the SD card, with the previous run's log, so a problem can be looked into after a reboot
LOGDIR=/var/lib/vacation
LOGFILE=$LOGDIR/vacation.log

start() {
	printf "Starting vacation: "
	dmesg -n 1                         # keep kernel messages off the display
	mkdir -p "$LOGDIR"
	[ -f "$LOGFILE" ] && mv -f "$LOGFILE" "$LOGFILE.1"
	# the CPU clock from /etc/vacation.conf (CPU_MHZ=600, say); nothing if it's empty
	MHZ=$(sed -n 's/^CPU_MHZ=\([0-9]*\).*/\1/p' /etc/vacation.conf 2>/dev/null)
	[ -n "$MHZ" ] && /usr/sbin/setcpu "$MHZ" >>"$LOGFILE" 2>&1
	start-stop-daemon -S -q -b -m -p "$PIDFILE" -x /bin/sh -- -c "
		while true; do
			/usr/bin/python3 -u $DAEMON >>$LOGFILE 2>&1 &
			echo \$! > $APPPIDFILE
			wait \$!
			echo \"vacation: exited with status \$?, restarting\" >>$LOGFILE
			sleep 2
		done" \
		&& echo "OK" || echo "FAIL"
}

stop() {
	printf "Stopping vacation: "
	start-stop-daemon -K -q -p "$PIDFILE"
	start-stop-daemon -K -q -p "$APPPIDFILE" && echo "OK" || echo "FAIL"
	rm -f "$PIDFILE" "$APPPIDFILE"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; sleep 1; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
